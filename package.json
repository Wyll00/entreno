{
  "name": "entrenos",
  "version": "0.1.0",
  "private": true,
  "description": "Registro personal de entrenamientos por texto y voz",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3210",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.ts",
    "user:password": "node --env-file-if-exists=.env scripts/set-password.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "restore:check": "node --env-file-if-exists=.env scripts/restore-check.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
