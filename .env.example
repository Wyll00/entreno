# Copia este archivo a .env y rellena los valores. .env no se versiona.

# URL pública con la que abres la app (en el servidor, la https del subdominio).
BETTER_AUTH_URL=http://localhost:3210
# Secreto de sesión: genera uno con  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Orígenes extra aceptados, separados por comas (opcional).
TRUSTED_ORIGINS=

# Ruta del archivo SQLite (en Docker: /data/workouts.sqlite).
DATABASE_PATH=./data/workouts.sqlite
APP_TIME_ZONE=Atlantic/Canary

# Copias de seguridad: carpeta fuera de la de la base de datos.
BACKUP_DIR=./backups
BACKUP_KEEP=7

# Proveedor de IA (etapas 2 y 4). Solo se usa en el servidor.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_EXTRACT_MODEL=
